# Rust usually needs more stack than C; the default main task stack is 3 KiB.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# These default stack sizes are also too small for typical Rust code.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096

# Default stack for threads spawned with std::thread. Prefer
# std::thread::Builder::stack_size for threads that need more.
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

# Optimize ESP-IDF itself for size, matching the Rust release profile.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
